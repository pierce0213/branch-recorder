# 工作区私有数据：AI 记忆、备份、会话状态
.workbuddy/

# 测试脚手架与中间产物
.audit/
**/.audit/

# 截图/构建日志
*.log.txt

# 本地临时草稿
_*.txt
._*
.android-probe.txt
.mk.txt
.pkg.py
.pkg.txt

# 系统杂物
Thumbs.db
.DS_Store
desktop.ini

# 在线发布包（由 测试版/.audit/build-online.mjs 生成）
online/

# 云服务/发布的应用标记（工作区本地状态，含本机绝对路径）
.wbapp_*.genie

# 安卓安装包（分发用的二进制，不进仓库；由 .workbuddy/android/ 下的脚本生成）
*.apk
*.idsig
